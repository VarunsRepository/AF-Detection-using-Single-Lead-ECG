{
    "ecg": {
        "version": 2,
        "label": "AFib Detection",
        "description": "Peak detection and HRV analysis on real ECG recordings.",
        "template": "shorts/journey_page.html",
        "api_endpoint": "/shorts/api/samples",
        "status": "production",
        "category": "afib",
        "feedback_score": 0,
        "globalThemes": {
            "activeTheme": "clinical_dark",
            "themes": [
                {
                    "id": "clinical_dark",
                    "palette": {
                        "primary": "#00FF66",
                        "accent": "#FF3366",
                        "secondary": "#00E5FF"
                    }
                }
            ]
        },
        "journeyRules": {
            "allowStageNavigation": true,
            "autoAdvance": true,
            "preloadNextStage": true
        },
        "uiShell": {
            "showProgressBar": true,
            "progressBar": {
                "position": "top",
                "activeColor": "globalThemes.activeTheme.palette.primary",
                "inactiveColor": "rgba(255,255,255,0.2)"
            }
        },
        "playbackConfig": {
            "isPaused": false
        },
        "layout": {
            "title": "bottom",
            "description": "bottom",
            "plot": "center",
            "caption": "bottom"
        },
        "stages": [
            {
                "stageId": "stage_01_peak_detection",
                "dataSource": {
                    "mode": "HTTP_REST"
                },
                "dspEngine": {
                    "availableAlgorithms": [
                        {
                            "id": "pan_tompkins",
                            "isDefault": true
                        },
                        {
                            "id": "hamilton_tompkins",
                            "isDefault": false
                        }
                    ],
                    "parameters": {
                        "invertSignal": false
                    }
                },
                "renderingEngine": {
                    "availableRenderers": [
                        {
                            "id": "chart_v1_canvas",
                            "isDefault": true
                        },
                        {
                            "id": "chart_v1_webgl",
                            "isDefault": false
                        },
                        {
                            "id": "chart_v1",
                            "isDefault": false
                        }
                    ],
                    "config": {}
                },
                "uiFillers": {
                    "title": "Finding Each Beat",
                    "caption": "Peaks are the topmost points in an ECG representing cardiac contraction.",
                    "description": "Uses whichever algorithm is currently selected -- try switching between Pan-Tompkins and Hamilton-Tompkins to compare."
                },
                "railControls": [
                    {
                        "ui": {
                            "label": "Invert",
                            "icon": "icon_flip_vertical"
                        },
                        "action": {
                            "target": "dspEngine",
                            "method": "setParameter",
                            "payload": {
                                "key": "invertSignal",
                                "operation": "toggle"
                            }
                        }
                    },
                    {
                        "ui": {
                            "label": "Algorithm",
                            "icon": "icon_cycle"
                        },
                        "action": {
                            "target": "dspEngine",
                            "method": "switchAlgorithm",
                            "payload": {}
                        }
                    },
                    {
                        "ui": {
                            "label": "Renderer",
                            "icon": "icon_renderer"
                        },
                        "action": {
                            "target": "renderingEngine",
                            "method": "switchRenderer",
                            "payload": {}
                        }
                    },
                    {
                        "ui": {
                            "label": "Speed"
                        },
                        "action": {
                            "target": "journey",
                            "method": "cycleSpeed",
                            "payload": {
                                "options": [
                                    0.5,
                                    1.0,
                                    1.5,
                                    2.0
                                ]
                            }
                        }
                    },
                    {
                        "ui": {
                            "label": "Theme",
                            "icon": "icon_theme"
                        },
                        "action": {
                            "target": "journey",
                            "method": "cycleTheme",
                            "payload": {}
                        }
                    }
                ],
                "stageOutput": {
                    "exportKey": "stage_01_processed_data",
                    "exportedFields": [
                        "rrIntervalsMs",
                        "peakIndices"
                    ]
                }
            },
            {
                "stageId": "stage_02_poincare_plot",
                "baseDurationMs": 8000,
                "dataSource": {
                    "mode": "PREVIOUS_STAGE_PIPELINE",
                    "stageId": "stage_01_peak_detection",
                    "outputKey": "stage_01_processed_data",
                    "consumedField": "rrIntervalsMs"
                },
                "dspEngine": {
                    "availableAlgorithms": [
                        {
                            "id": "poincare_standard",
                            "isDefault": true
                        }
                    ],
                    "parameters": {}
                },
                "renderingEngine": {
                    "availableRenderers": [
                        {
                            "id": "scatter_density",
                            "isDefault": true
                        }
                    ],
                    "config": {}
                },
                "uiFillers": {
                    "title": "HRV Poincare Plot",
                    "caption": "The width (SD1) and length (SD2) of the cloud reflect short- and long-term heart rate variability."
                },
                "railControls": [
                    {
                        "ui": {
                            "label": "Speed"
                        },
                        "action": {
                            "target": "journey",
                            "method": "cycleSpeed",
                            "payload": {
                                "options": [
                                    0.5,
                                    1.0,
                                    1.5,
                                    2.0
                                ]
                            }
                        }
                    },
                    {
                        "ui": {
                            "label": "Theme",
                            "icon": "icon_theme"
                        },
                        "action": {
                            "target": "journey",
                            "method": "cycleTheme",
                            "payload": {}
                        }
                    }
                ]
            },
            {
                "stageId": "stage_03_rr_tachogram",
                "dataSource": {
                    "mode": "PREVIOUS_STAGE_PIPELINE",
                    "stageId": "stage_01_peak_detection",
                    "outputKey": "stage_01_processed_data",
                    "consumedField": "rrIntervalsMs"
                },
                "dspEngine": {
                    "availableAlgorithms": [
                        {
                            "id": "passthrough",
                            "isDefault": true
                        }
                    ],
                    "parameters": {}
                },
                "renderingEngine": {
                    "availableRenderers": [
                        {
                            "id": "rr_tachogram",
                            "isDefault": true
                        }
                    ],
                    "config": {}
                },
                "uiFillers": {
                    "title": "RR Tachogram",
                    "caption": "Each point is one heartbeat. Shorter intervals = faster heart rate.",
                    "description": "Trends, ectopic beats and arrhythmias appear as sudden vertical shifts in the line."
                },
                "railControls": [
                    {
                        "ui": {
                            "label": "Speed",
                            "icon": "icon_speed"
                        },
                        "action": {
                            "target": "journey",
                            "method": "cycleSpeed",
                            "payload": {}
                        }
                    },
                    {
                        "ui": {
                            "label": "Theme",
                            "icon": "icon_theme"
                        },
                        "action": {
                            "target": "journey",
                            "method": "cycleTheme",
                            "payload": {}
                        }
                    }
                ],
                "baseDurationMs": 8000
            }
        ]
    },
